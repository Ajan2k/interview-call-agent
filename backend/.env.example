
# Together AI LLM (Primary fast model for ultra-low latency & high rate limits)
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
# Set LLM_PROVIDER=together to force Together AI, or leave unset to auto-detect TOGETHER_API_KEY
LLM_PROVIDER=together

# AI Voice Agent Keys
GROQ_API_KEY=your_groq_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia

# Cartesia TTS (primary) — Sonic 3.5 model, Tamil 'Kavitha' voice
CARTESIA_API_KEY=your_cartesia_api_key_here
# Cartesia Sonic model id (e.g. sonic-2 / sonic-3.5 depending on your account access)
CARTESIA_MODEL_ID=sonic-2
# Voice id (UUID) for the Tamil 'Kavitha' voice — used as the agent's default voice
CARTESIA_KAVITHA_VOICE_ID=your_kavitha_voice_id_here
# Optional per-language voice id overrides
# CARTESIA_VOICE_TA=
# CARTESIA_VOICE_EN=
# CARTESIA_VOICE_HI=
