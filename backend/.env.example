# ==============================================================================
# TeleForce AI Calling Agent — Backend Environment Configuration
# ==============================================================================

# --- LLM Provider Selection ---
# Supported providers: groq (default), together, gemini, cerebras, sarvam
LLM_PROVIDER=groq

# Groq API (Default fast model: llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=llama-3.1-8b-instant

# Together AI (Optional: high rate-limits & fast inference)
# TOGETHER_API_KEY=your_together_api_key_here
# TOGETHER_LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# Google Gemini API (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_LLM_MODEL=gemini-flash-lite-latest

# Cerebras API (Optional)
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# CEREBRAS_LLM_MODEL=zai-glm-4.7

# --- Speech Services (STT & TTS) ---
# Cartesia TTS (Primary neural speech synthesis)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_MODEL_ID=sonic-2
CARTESIA_KAVITHA_VOICE_ID=your_kavitha_voice_id_here
# Optional per-language voice overrides:
# CARTESIA_VOICE_TA=
# CARTESIA_VOICE_EN=
# CARTESIA_VOICE_HI=

# Sarvam AI (Speech-to-Text, Indic TTS & Translation)
SARVAM_API_KEY=your_sarvam_api_key_here

# Azure Speech Services (Fallback TTS/STT)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skyagent

# Optional full connection URL (overrides individual POSTGRES_* settings above):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/skyagent

# --- Call & Pipeline Settings ---
MAX_CALL_DURATION_SECS=300
LOG_API_POLLING=false
